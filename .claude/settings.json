{
  "enabledPlugins": {
    "pstack@pstack-claude": false
  },
  "permissions": {
    "allow": [
      "mcp__Linear__get_issue",
      "mcp__Linear__list_issues",
      "mcp__Linear__list_comments",
      "mcp__Linear__save_comment",
      "mcp__Linear__get_issue_status",
      "mcp__Linear__list_issue_statuses",
      "mcp__Linear__list_issue_labels",
      "mcp__Linear__get_document",
      "mcp__Linear__list_documents",
      "mcp__Linear__extract_images",
      "mcp__Linear__get_attachment",
      "mcp__Linear__get_project",
      "mcp__Linear__list_projects",
      "mcp__Linear__get_team",
      "mcp__Linear__list_teams",
      "mcp__Linear__get_user",
      "mcp__Linear__list_users",
      "mcp__Linear__whoami"
    ],
    "deny": [
      "Read(.env.local)",
      "Edit(.claude/agent-merge.json)",
      "Bash(gh pr merge)",
      "Bash(gh pr merge*)",
      "Bash(gh api *pulls/*/merge*)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git -C * push *--force*)",
      "Bash(git -C * push -f*)",
      "Bash(git -C * push * -f*)",
      "Bash(git -C * push * +*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/cloud-setup.mjs\"",
            "timeout": 600
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pstack-context.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pocock-skills.mjs\"",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-before-commit.mjs\"",
            "timeout": 300
          },
          {
            "type": "command",
            "if": "Bash(git -C * commit *)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-before-commit.mjs\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
