# Personal or development key from https://developer.riotgames.com
# Copy this file to .env.local and fill it in. Never commit the real key.
RIOT_API_KEY=

# Sentry error tracking (https://jaspys-team.sentry.io, project "turnpoint").
# The DSN is safe to expose: it only lets the app send errors in.
NEXT_PUBLIC_SENTRY_DSN=
# Lets the build upload source maps. Secret: set it in Vercel, never commit it.
SENTRY_AUTH_TOKEN=

# Supabase Postgres, from the "Connect" button in the Supabase dashboard.
# Transaction pooler (port 6543): used by the app, including on Vercel.
DATABASE_URL=
# Session pooler (port 5432): used only by `npm run db:migrate` on your machine.
DATABASE_URL_DIRECT=

# Supabase Auth, for signing in with Google and Discord. Both are public values:
# Supabase dashboard > Project Settings > API Keys (publishable key) and the
# project URL. Leave them empty and the site simply hides "Sign in".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Claude API key for the "Write recap" button, from https://console.anthropic.com.
# Secret: set it in Vercel, never commit it. Leave it empty to hide the button.
ANTHROPIC_API_KEY=

# Lets `npm run shot -- --pr <number>` and `npm run test:e2e` past a preview's
# Vercel login. The same value as the GitHub secret of that name, from Vercel
# project > Settings > Deployment Protection > Protection Bypass for Automation.
# Secret: never commit it. Not needed in Vercel itself.
VERCEL_AUTOMATION_BYPASS_SECRET=
