# Personal or development key from https://developer.riotgames.com
# Copy this file to .env.local and fill it in. Never commit the real key.
RIOT_API_KEY=

# Sentry error tracking (https://jaspys-team.sentry.io, project "turnpoint").
# The DSN is safe to expose: it only lets the app send errors in.
NEXT_PUBLIC_SENTRY_DSN=
# Lets the build upload source maps. Secret: set it in Vercel, never commit it.
SENTRY_AUTH_TOKEN=
