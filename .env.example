# Personal or development key from https://developer.riotgames.com
# Copy this file to .env.local and fill it in. Never commit the real key.
RIOT_API_KEY=

# Supabase Postgres, from the "Connect" button in the Supabase dashboard.
# Transaction pooler (port 6543): used by the app, including on Vercel.
DATABASE_URL=
# Session pooler (port 5432): used only by `npm run db:migrate` on your machine.
DATABASE_URL_DIRECT=
